APP_ENV=development
APP_NAME=ReqForge API
API_V1_PREFIX=/api/v1
# Render's postgresql:// URL is accepted and normalized to the installed psycopg driver.
DATABASE_URL=postgresql+psycopg://reqforge:reqforge@localhost:5432/reqforge
# Development and automated tests: stub. Real providers: openai, openai_compatible, reqforge-v1.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
# Optional for direct OpenAI; override for another OpenAI-compatible provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
FEEDBACK_ANALYSIS_BATCH_SIZE=10
ANALYSIS_WORKER_POLL_SECONDS=0.5
ANALYSIS_STALE_SECONDS=300
ANALYSIS_MAX_ATTEMPTS=3
PUBLIC_FEEDBACK_BASE_URL=http://localhost:5173/feedback
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PUBLIC_SUBMIT_PER_HOUR=20
RATE_LIMIT_ANALYSIS_PER_MINUTE=10
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Required when using the backend outside Docker Compose.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_IMPORT_BYTES=5000000
