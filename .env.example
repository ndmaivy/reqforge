# Development and automated tests: stub. Real providers: openai, openai_compatible, reqforge-v1.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
# Optional for direct OpenAI; override for another OpenAI-compatible provider.
LLM_BASE_URL=https://api.openai.com/v1
CORS_ORIGINS=http://localhost:5173
# Required for the Docker Compose backend. Generate a unique local value, for example:
# openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
